{
  "name": "relay-reliable-events-example",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "UseNewLuauTypeSolver": "Enabled" }
    },
    "ReplicatedStorage": {
      "Relay": { "$path": "../../src" },
