option remote_scope = "RELAY_EVENT_V1_NETRAY";
option Validate = Full;

event Tiny {
    From: Both,
    Type: Reliable,
    Call: SingleSync,
    Data: (u32, boolean),
}
event State {
    From: Both,
    Type: Reliable,
    Call: SingleSync,
    Data: (u32, u16, vector<f32>, f32, u8),
}
event Strings {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: (u32, string),
}
event Numbers {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: (u32, i8, i16, i32),
}
event Vectors {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: (u32, vector<f32>),
}
